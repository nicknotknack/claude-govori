#!/bin/bash
# govori: spoken Claude replies, synthesized by Piper. A reply in a language with no installed voice stays silent.
PATH="$HOME/.local/bin:$PATH"
D="$HOME/.claude/govori"; S="$D/sessions"; V="$D/voices"

# State: voice is on per session (flag file $S/<session id>). Hooks get the id on stdin, commands via env.
flag() { # flag file for session id $1; fails if there is no usable id
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] && echo "$S/$1"
}

is_on() { local f; f=$(flag "$1") && [ -f "$f" ]; }

set_flag() { # $1 on|off
  local f; f=$(flag "${CLAUDE_CODE_SESSION_ID:-}") || { echo "govori: no session id. Run it inside Claude Code." >&2; return 1; }
  if [ "$1" = on ]; then
    mkdir -p "$S" && : > "$f" || return 1
    find "$S" -type f -mtime +14 -delete 2>/dev/null
  else
    rm -f "$f"
  fi
}

rules() { cat <<'R'
Voice mode is ON: the last block of each reply is read aloud by a text-to-speech engine.
End EVERY reply with this block, as the very last thing in the message:

🔊 <the gist in one or two short plain sentences, in the user's language>

- Short and to the point: result or answer only. No greetings, filler or step-by-step recap.
- Plain speakable text: no markdown, code, paths or URLs, unless the user asks you to read them out.
- If the user asks you to dictate or read aloud something (code, text, list, explanation), put exactly that after 🔊; it may span several lines.
- Everything above the block is the normal reply. Never repeat it in the block: if the whole reply is one short sentence, write only the 🔊 line.
R
}

lang() { # language of $1 (en, ru, de, ...); call it in $(...), it changes the shell's locale and options
  local o=${LC_ALL-} w c=0 n=0 l other=$'*[\xC3-\xDF\xE0\xE1\xE3-\xEF]*'
  LC_ALL=C; set -f # by bytes: in UTF-8 Cyrillic letters start with D0/D1, punctuation with C2/E2, emoji with F0
  for w in $1; do # by words, so Russian full of English terms stays Russian
    [[ $w == *[a-zA-Z$'\xD0\xD1']* ]] || continue
    n=$((n+1)); [[ $w == *[$'\xD0\xD1']* ]] && c=$((c+1))
  done
  if [ "$c" -gt 0 ] && [ $((c*4)) -ge "$n" ]; then
    case $1 in *$'\xD1\x96'*|*$'\xD1\x97'*|*$'\xD1\x94'*|*$'\xD2\x91'*|*$'\xD0\x86'*|*$'\xD0\x87'*|*$'\xD0\x84'*|*$'\xD2\x90'*) echo uk ;; *) echo ru ;; esac # і ї є ґ
    return
  fi
  [[ $1 == $other ]] || { echo en; return; }
  LC_ALL=$o # anything else: macOS NaturalLanguage, ~0.1 s
  l=$(osascript -l JavaScript -e 'function run(a){ObjC.import("NaturalLanguage");var r=$.NLLanguageRecognizer.alloc.init;r.processString(a[0]);var l=ObjC.unwrap(r.dominantLanguage),p=ObjC.deepUnwrap(r.languageHypothesesWithMaximum(9));if(/^(bg|mk|sr|be|kk)$/.test(l))l=(p.uk||0)>(p.ru||0)?"uk":"ru";return l}' " $1" 2>/dev/null)
  echo "${l%%-*}"
}

pick() { # preferred voice name for language $1 from GOVORI_VOICES="ru=ruslan,en=ryan"
  local kv IFS=,
  for kv in ${GOVORI_VOICES:-}; do [ "${kv%%=*}" = "$1" ] && echo "${kv#*=}"; done
}

voices() { ls "$V" 2>/dev/null | sed -n 's/\.onnx$//p'; }

model() { # Piper model file for language $1: the preferred voice, else the first installed; empty if none
  { ls "$V/$1"_*"$(pick "$1")"*.onnx || ls "$V/$1"_*.onnx; } 2>/dev/null | head -1
}

has_piper() { command -v piper >/dev/null || { echo "govori: Piper is not installed. Run: pipx install piper-tts" >&2; return 1; }; }

has_voices() { [ -n "$(voices)" ] || { echo "govori: no voices installed. Run: /govori get ru_RU-denis-medium en_US-ryan-medium" >&2; return 1; }; }

piper_python() { echo "$(dirname "$(readlink -f "$(command -v piper)")")/python"; }

# Voice server (bin/govori-server.py): keeps Piper models in memory while voice mode is in use.
server_send() { # ask it to speak: $1 model, $2 length scale, $3 text; prints ok or err, nothing if it is not running
  [ -S "$D/piper.sock" ] && (cd "$D" && printf '%s\n%s\n%s\0' "$1" "$2" "$3" | nc -U piper.sock 2>/dev/null)
}

server_start() { # in the background, voice $1 first, then one per installed language; a second copy exits by itself
  local l m a=()
  [ -n "${1:-}" ] && a=("$1")
  for l in $(voices | sed 's/_.*//' | sort -u); do
    m=$(model "$l"); [ -n "$m" ] && a+=("$m")
  done
  nohup "$(piper_python)" -I "${0%/*}/govori-server.py" "$D" "${a[@]}" </dev/null >/dev/null 2>&1 &
}

server_stop() {
  [ -S "$D/piper.sock" ] && (cd "$D" && printf 'quit\0' | nc -U piper.sock) >/dev/null 2>&1 &
}

piper_talk() { # $1 model, $2 length scale, $3 text
  local i r w="$D/$$.wav"
  r=$(server_send "$@")
  if [ -z "$r" ] && [ -n "${VOICE_ON:-}" ] && server_start "$1"; then # never started just for `test` while voice mode is off
    for i in {1..50}; do
      sleep 0.1; r=$(server_send "$@"); [ -n "$r" ] && break
    done
  fi
  [ "$r" = ok ] && return
  piper -m "$1" --length-scale "$2" -f "$w" <<<"$3" && afplay "$w"; rm -f "$w"
}

talk() { # speak $1 aloud; replaces whatever is still playing
  local l p
  has_piper || return 1
  l=$(lang "$1"); p=$(model "$l")
  [ -n "$p" ] || { echo "govori: no voice for language '$l'. List them with: /govori get" >&2; return 1; }
  pkill -x afplay
  piper_talk "$p" "$(awk -v s="${GOVORI_SPEED:-1.17}" 'BEGIN{printf "%.2f", 1/s}')" "$1" >/dev/null 2>&1 &
}

jget() { plutil -extract "$1" raw -o - - 2>/dev/null <<<"$2"; } # field $1 of JSON $2

hook_sid() { # session id: from the hook's JSON on stdin, else from the environment
  local re='"session_id": *"([^"]+)"' # can't match inside a JSON string: quotes are escaped there
  if [[ $1 =~ $re ]]; then echo "${BASH_REMATCH[1]}"; else echo "${CLAUDE_CODE_SESSION_ID:-}"; fi
}

speak() { # $1: JSON from the Stop hook
  is_on "$(hook_sid "$1")" || return 0
  local m VOICE_ON=1
  m=$'\n'$(jget last_assistant_message "$1") || return 0
  [[ $m == *$'\n🔊'* ]] || return 0
  m=${m##*$'\n'🔊}; m=${m//[\`*#]/}
  [ -n "${m//[[:space:]]/}" ] && talk "$m"
  return 0
}

case "${1:-toggle}" in
  hook-start) j=$(cat); is_on "$(hook_sid "$j")" && rules ;;
  hook-stop)  speak "$(cat)" ;;
  on)     has_piper && has_voices && set_flag on || exit 1; server_start; echo "Voice replies ON for this session."; rules ;;
  off)    set_flag off || exit 1; server_stop; echo "Voice replies OFF for this session. Stop adding the 🔊 block to replies." ;;
  toggle) if is_on "${CLAUDE_CODE_SESSION_ID:-}"; then "$0" off; else "$0" on; fi ;;
  status) if is_on "${CLAUDE_CODE_SESSION_ID:-}"; then echo on; else echo off; fi ;;
  voices) voices ;;
  get)    has_piper || exit 1; shift; mkdir -p "$V"; "$(piper_python)" -m piper.download_voices --data-dir "$V" "$@" ;;
  test)   shift; talk "${*:-All done, tests are green.}" || exit 1; wait ;;
  *)      echo "usage: govori [on|off|status|voices|get <voice>...|test [text]]"; exit 1 ;;
esac
