#!/bin/bash
# govori: spoken Claude replies, synthesized by Piper. A reply in a language with no installed voice stays silent.
PATH="$HOME/.local/bin:$PATH"
D="$HOME/.claude/govori"; ON="$D/on"; S="$D/sessions"; V="$D/voices"; C="$D/config"

# Settings: plain key=value lines, parsed here and never sourced. setup=done marks a finished first run.
SCOPE=session; SPEED=1.17; PITCH=1; VOICES=; SETUP=
[ -f "$C" ] && while IFS='=' read -r k v; do
  case $k in scope) SCOPE=$v ;; speed) SPEED=$v ;; pitch) PITCH=$v ;; voices) VOICES=$v ;; setup) SETUP=$v ;; esac
done < "$C"

save_config() {
  mkdir -p "$D" && printf 'scope=%s\nspeed=%s\npitch=%s\nvoices=%s\nsetup=%s\n' "$SCOPE" "$SPEED" "$PITCH" "$VOICES" "$SETUP" > "$C.$$" && mv -f "$C.$$" "$C"
}

# State: per session a flag file $S/<session id>; with scope=global one flag file $ON shared by every session.
# Hooks get the id on stdin, commands via env.
global() { [ "$SCOPE" = global ]; }

flag() { # flag file for session id $1 in the current scope; fails if there is no usable id
  if global; then echo "$ON"; return; fi
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] && echo "$S/$1"
}

is_on() { local f; f=$(flag "$1") && [ -f "$f" ]; }

scope_name() { if global; then echo "ALL sessions (ones already open need a restart to get the rules)"; else echo "this session"; fi; }

set_flag() { # $1 on|off
  local f; f=$(flag "${CLAUDE_CODE_SESSION_ID:-}") || { echo "govori: no session id. Run it inside Claude Code." >&2; return 1; }
  if [ "$1" = on ]; then
    mkdir -p "$S" && : > "$f" || return 1
    find "$S" -type f -mtime +14 -delete 2>/dev/null
  else
    rm -f "$f"
  fi
}

rules() { cat <<'R'
Voice mode is ON: the last block of each reply is read aloud by a text-to-speech engine.
End EVERY reply with this block, as the very last thing in the message:

🔊 <the gist in one or two short plain sentences, in the user's language>

- Short and to the point: result or answer only. No greetings, filler or step-by-step recap.
- Plain speakable text: no markdown, code, paths or URLs, unless the user asks you to read them out.
- If the user asks you to dictate or read aloud something (code, text, list, explanation), put exactly that after 🔊; it may span several lines.
- Everything above the block is the normal reply. Never repeat it in the block: if the whole reply is one short sentence, write only the 🔊 line.
R
}

lang() { # language of $1 (en, ru, de, ...); call it in $(...), it changes the shell's locale and options
  local o=${LC_ALL-} w c=0 n=0 l other=$'*[\xC3-\xDF\xE0\xE1\xE3-\xEF]*'
  LC_ALL=C; set -f # by bytes: in UTF-8 Cyrillic letters start with D0/D1, punctuation with C2/E2, emoji with F0
  for w in $1; do # by words, so Russian full of English terms stays Russian
    [[ $w == *[a-zA-Z$'\xD0\xD1']* ]] || continue
    n=$((n+1)); [[ $w == *[$'\xD0\xD1']* ]] && c=$((c+1))
  done
  if [ "$c" -gt 0 ] && [ $((c*4)) -ge "$n" ]; then
    case $1 in *$'\xD1\x96'*|*$'\xD1\x97'*|*$'\xD1\x94'*|*$'\xD2\x91'*|*$'\xD0\x86'*|*$'\xD0\x87'*|*$'\xD0\x84'*|*$'\xD2\x90'*) echo uk ;; *) echo ru ;; esac # і ї є ґ
    return
  fi
  [[ $1 == $other ]] || { echo en; return; }
  LC_ALL=$o # anything else: macOS NaturalLanguage, ~0.1 s
  l=$(osascript -l JavaScript -e 'function run(a){ObjC.import("NaturalLanguage");var r=$.NLLanguageRecognizer.alloc.init;r.processString(a[0]);var l=ObjC.unwrap(r.dominantLanguage),p=ObjC.deepUnwrap(r.languageHypothesesWithMaximum(9));if(/^(bg|mk|sr|be|kk)$/.test(l))l=(p.uk||0)>(p.ru||0)?"uk":"ru";return l}' " $1" 2>/dev/null)
  echo "${l%%-*}"
}

pick() { # preferred voice name for language $1 from voices=ru=ruslan,en=ryan
  local kv IFS=,
  for kv in $VOICES; do [ "${kv%%=*}" = "$1" ] && echo "${kv#*=}"; done
}

voices() { ls "$V" 2>/dev/null | sed -n 's/\.onnx$//p'; }

model() { # Piper model file for language $1: the preferred voice, else the first installed; empty if none
  { ls "$V/$1"_*"$(pick "$1")"*.onnx || ls "$V/$1"_*.onnx; } 2>/dev/null | head -1
}

has_piper() { command -v piper >/dev/null || { echo "govori: Piper is not installed. Run: pipx install piper-tts" >&2; return 1; }; }

has_voices() { [ -n "$(voices)" ] || { echo "govori: no voices installed. Run: /govori get ru_RU-dmitri-medium en_US-ryan-medium" >&2; return 1; }; }

piper_python() { echo "$(dirname "$(readlink -f "$(command -v piper)")")/python"; }

# Voice server (bin/govori-server.py): keeps Piper models in memory while voice mode is in use.
server_send() { # ask it to speak: $1 model, $2 length scale, $3 pitch, $4 text; prints ok or err, nothing if it is not running
  [ -S "$D/piper.sock" ] && (cd "$D" && printf '%s\n%s\n%s\n%s\0' "$1" "$2" "$3" "$4" | nc -U piper.sock 2>/dev/null)
}

server_start() { # in the background, voice $1 first, then one per installed language; a second copy exits by itself
  local l m a=()
  [ -n "${1:-}" ] && a=("$1")
  for l in $(voices | sed 's/_.*//' | sort -u); do
    m=$(model "$l"); [ -n "$m" ] && a+=("$m")
  done
  nohup "$(piper_python)" -I "${0%/*}/govori-server.py" "$D" "${a[@]}" </dev/null >/dev/null 2>&1 &
}

server_stop() {
  [ -S "$D/piper.sock" ] && (cd "$D" && printf 'quit\0' | nc -U piper.sock) >/dev/null 2>&1 &
}

piper_talk() { # $1 model, $2 length scale, $3 pitch, $4 text
  local i r w="$D/$$.wav"
  r=$(server_send "$@")
  if [ -z "$r" ] && [ -n "${VOICE_ON:-}" ] && server_start "$1"; then # never started just for `test` while voice mode is off
    for i in {1..50}; do
      sleep 0.1; r=$(server_send "$@"); [ -n "$r" ] && break
    done
  fi
  [ "$r" = ok ] && return
  piper -m "$1" --length-scale "$2" -f "$w" <<<"$4" && { [ "$3" = 1 ] || "$(piper_python)" -I "${0%/*}/govori-server.py" --retune "$w" "$3"; } && afplay "$w"; rm -f "$w"
}

talk() { # speak $1 aloud; replaces whatever is still playing
  local l p
  has_piper || return 1
  l=$(lang "$1"); p=$(model "$l")
  [ -n "$p" ] || { echo "govori: no voice for language '$l'. List them with: /govori get" >&2; return 1; }
  pkill -x afplay
  piper_talk "$p" "$(awk -v s="$SPEED" -v t="$PITCH" 'BEGIN{printf "%.2f", t/s}')" "$PITCH" "$1" >/dev/null 2>&1 &
}

jget() { plutil -extract "$1" raw -o - - 2>/dev/null <<<"$2"; } # field $1 of JSON $2

hook_sid() { # session id: from the hook's JSON on stdin, else from the environment
  local re='"session_id": *"([^"]+)"' # can't match inside a JSON string: quotes are escaped there
  if [[ $1 =~ $re ]]; then echo "${BASH_REMATCH[1]}"; else echo "${CLAUDE_CODE_SESSION_ID:-}"; fi
}

speak() { # $1: JSON from the Stop hook
  is_on "$(hook_sid "$1")" || return 0
  local m VOICE_ON=1
  m=$'\n'$(jget last_assistant_message "$1") || return 0
  [[ $m == *$'\n🔊'* ]] || return 0
  m=${m##*$'\n'🔊}; m=${m//[\`*#]/}
  [ -n "${m//[[:space:]]/}" ] && talk "$m"
  return 0
}

need_setup() { # true, with instructions for the skill, until the first run is finished
  [ "$SETUP" = done ] && return 1
  echo "SETUP NEEDED. piper: $(command -v piper >/dev/null && echo installed || echo missing). installed voices: $(voices | tr '\n' ' ')"
}

turn_on() {
  has_piper && has_voices && set_flag on || exit 1
  server_start; echo "Voice replies ON for $(scope_name)."; rules
}

settings() {
  echo "SETTINGS"
  echo "voice replies: $(is_on "${CLAUDE_CODE_SESSION_ID:-}" && echo on || echo off)"
  echo "scope: $SCOPE"; echo "speed: $SPEED"; echo "pitch: $PITCH"; echo "voices: $VOICES"
  echo "installed voices: $(voices | tr '\n' ' ')"
}

set_scope() { # keeps voice on for the current session across the switch
  local on=; is_on "${CLAUDE_CODE_SESSION_ID:-}" && on=1
  [ -z "$on" ] || set_flag off
  SCOPE=$1; save_config || return 1
  [ -z "$on" ] || set_flag on
}

set_voice() { # $1 language, $2 voice: full name or part of it; replaces that language's choice
  local n=${2#"$1"_} kv out= IFS=,
  [[ $1 =~ ^[a-z]{2,3}$ && $n =~ ^[A-Za-z0-9_-]+$ ]] && ls "$V/$1"_*"$n"*.onnx >/dev/null 2>&1 || { echo "govori: voice '$2' for language '$1' is not installed." >&2; return 1; }
  for kv in $VOICES; do [ "${kv%%=*}" = "$1" ] || out+="${out:+,}$kv"; done
  VOICES="$out${out:+,}$1=$n"; save_config
}

set_option() { # scope session|global, speed <0.5-3>, pitch <0.7-1.3>, voice <language> <voice>
  case "$1=${2:-}" in
    scope=session|scope=global) set_scope "$2" ;;
    speed=*) [[ $2 =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v s="$2" 'BEGIN{exit !(s>=0.5 && s<=3)}' || { echo "govori: speed must be a number from 0.5 to 3." >&2; return 1; }
      SPEED=$2; save_config ;;
    pitch=*) [[ $2 =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v p="$2" 'BEGIN{exit !(p>=0.7 && p<=1.3)}' || { echo "govori: pitch must be a number from 0.7 to 1.3." >&2; return 1; }
      PITCH=$2; save_config ;;
    voice=?*) set_voice "$2" "${3:-}" ;;
    *) echo "usage: govori set scope session|global | speed <0.5-3> | pitch <0.7-1.3> | voice <language> <voice>" >&2; return 1 ;;
  esac
}

install_piper() { # pipx, via Homebrew if needed; a Python too new for Piper falls back to 3.13
  command -v piper >/dev/null && { echo "Piper is already installed."; return; }
  command -v pipx >/dev/null || { command -v brew >/dev/null && brew install pipx; } || { echo "govori: pipx is required. Install it (https://pipx.pypa.io) and retry." >&2; return 1; }
  pipx install piper-tts || { command -v brew >/dev/null && brew install python@3.13 && pipx install --python python3.13 piper-tts; } || return 1
  command -v piper >/dev/null
}

case "${1:-toggle}" in
  hook-start) j=$(cat); is_on "$(hook_sid "$j")" && rules ;;
  hook-stop)  speak "$(cat)" ;;
  on)     need_setup || turn_on ;;
  off)    set_flag off || exit 1; server_stop; echo "Voice replies OFF for $(scope_name). Stop adding the 🔊 block to replies." ;;
  toggle) if is_on "${CLAUDE_CODE_SESSION_ID:-}"; then "$0" off; else "$0" on; fi ;;
  status) if is_on "${CLAUDE_CODE_SESSION_ID:-}"; then echo on; else echo off; fi ;;
  settings) need_setup || settings ;;
  set)    shift; set_option "$@" ;;
  setup-done) has_piper && has_voices || exit 1; SETUP=done; save_config || exit 1; turn_on ;;
  install-piper) install_piper ;;
  voices) voices ;;
  catalog) has_piper || exit 1; "$0" get | grep "^${2:-none}_" ;;
  get)    has_piper || exit 1; shift; mkdir -p "$V"; "$(piper_python)" -m piper.download_voices --data-dir "$V" "$@" ;;
  remove) [[ ${2:-} =~ ^[A-Za-z0-9_-]+$ ]] || { echo "usage: govori remove <voice>" >&2; exit 1; }; rm -f "$V/$2.onnx" "$V/$2.onnx.json" ;;
  test)   shift; talk "${*:-All done, tests are green.}" || exit 1; wait ;;
  *)      echo "usage: govori [on|off|status|settings|set <option> <value>|voices|catalog <language>|get <voice>...|remove <voice>|test [text]]"; exit 1 ;;
esac
